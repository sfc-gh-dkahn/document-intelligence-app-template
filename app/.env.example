# Document Intelligence: environment variables
# For SPCS deployments: deployment variables (database, warehouse, roles) are set
# in deploy.config at the repo root. The deploy script generates .env automatically.
# This file documents app-specific overrides for local development or branding.

# =============================================================================
# SNOWFLAKE CONNECTION (local development only — SPCS uses token injection)
# =============================================================================
SNOWFLAKE_ACCOUNT=your-account.snowflakecomputing.com
SNOWFLAKE_USER=your-user
SNOWFLAKE_PASSWORD=your-password
SNOWFLAKE_WAREHOUSE=DOC_INTEL_QUERY_WH
SNOWFLAKE_DATABASE=DOC_INTEL
SNOWFLAKE_SCHEMA=APP

# Required for Cortex Analyst (/api/analyst) and Cortex Agent (/api/agent) REST calls.
# In SPCS production, SNOWFLAKE_HOST is injected automatically by the runtime.
# For local development, set SNOWFLAKE_ACCOUNT_URL to your account's full URL:
# SNOWFLAKE_ACCOUNT_URL=https://your-account.snowflakecomputing.com

# =============================================================================
# DATABASE CONFIGURATION
# Set by deploy.sh from config/deploy.config. To rename objects, run scripts/rename.sh.
# =============================================================================
DOC_INTEL_DATABASE=DOC_INTEL

# Schema for AI services (agent, search, semantic view)
DOC_INTEL_SERVICES_SCHEMA=SERVICES

# Public display name for the database (shown in admin SQL snippets in the UI)
# Must match DOC_INTEL_DATABASE — needs NEXT_PUBLIC_ prefix for client-side access
NEXT_PUBLIC_DB_DISPLAY=DOC_INTEL

# Cortex Search service name (default: doc_search_svc)
# Set if your deployment uses a different Cortex Search service name
DOC_INTEL_SEARCH_SVC=doc_search_svc
DOC_INTEL_PAGE_SEARCH_SVC=doc_page_search_svc

# LLM model for conversational Q&A (default: claude-sonnet-4-5)
# Set to use a different Cortex model available in your account
DOC_INTEL_CORTEX_MODEL=claude-sonnet-4-5

# Cortex Agent object name (override if using a custom agent)
DOC_INTEL_AGENT_NAME=doc_intelligence_agent

# =============================================================================
# THEMING (local development only)
# The deployed app does not upload .env files. To brand the deployed app, edit
# the defaults in theme.config.ts. See "Customizing by hand" in docs/OPERATIONS_GUIDE.md.
# =============================================================================
NEXT_PUBLIC_APP_NAME=Document Intelligence
NEXT_PUBLIC_APP_SUBTITLE=Powered by Snowflake Cortex AI
NEXT_PUBLIC_BRAND_COLOR=#29B5E8
NEXT_PUBLIC_BRAND_DARK=#11567F
NEXT_PUBLIC_BRAND_BG=#0A1428
NEXT_PUBLIC_LOGO_URL=/icon.svg

# =============================================================================
# DEBUG / LOGGING
# =============================================================================
# Set to 1 to suppress Snowflake SDK query logs
SNOWFLAKE_SDK_QUIET=0
