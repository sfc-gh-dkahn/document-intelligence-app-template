# =============================================================================
# DOC_INTEL: Deployment Configuration
# =============================================================================
# Used by: provision.sh, deploy.sh, quickstart.sh, and the app
# (.env generation).
#
# Object names (DOC_INTEL, DOC_INTEL_ADMIN, ...) also appear as literals in
# sql/, the scripts, and app/snowflake.yml. Do not edit them by hand. To change
# them, run scripts/rename.sh, which rewrites every file at once.
# =============================================================================

# --- Snowflake CLI connection ---
# Name of the connection in ~/.snowflake/connections.toml (or config.toml).
# Leave empty to use your default connection. The --connection=NAME flag on any
# script overrides this.
SNOW_CONNECTION=${SNOW_CONNECTION:-}

# --- Databases ---
DOC_INTEL_DATABASE=DOC_INTEL
DOC_INTEL_DATA_SCHEMA=DATA
DOC_INTEL_SERVICES_SCHEMA=SERVICES
DOC_INTEL_APP_SCHEMA=APP_SERVICE

# --- Warehouses ---
DOC_INTEL_QUERY_WAREHOUSE=DOC_INTEL_QUERY_WH
DOC_INTEL_PIPELINE_WH=DOC_INTEL_WH

# --- Compute ---
DOC_INTEL_COMPUTE_POOL=DOC_MONITOR_POOL

# --- Roles ---
DOC_INTEL_ADMIN_ROLE=DOC_INTEL_ADMIN
DOC_INTEL_USER_ROLE=DOC_INTEL_USER
DOC_INTEL_PIPELINE_ROLE=DOC_INTEL_PIPELINE

# --- Extra admin user (optional) ---
# provision.sh always grants all three roles to the user it runs as.
# Set this to also grant them to one more Snowflake user (for example, when an
# account admin provisions and someone else deploys). Leave empty to skip.
DOC_INTEL_DEFAULT_USER=${DOC_INTEL_DEFAULT_USER:-}

# --- Pipeline schedule ---
# How often the pipeline checks for new files. Each run processes up to 100
# documents (batch_size). Uploading with scripts/upload_docs.sh always starts a
# run right away, and --drain keeps starting runs until nothing is waiting, so a
# slow schedule doesn't slow down loads. Pick the slowest schedule that works:
# every scheduled run wakes the pipeline warehouse.
#   Daily (default)        USING CRON 0 6 * * * UTC
#   Weekly (Mondays)       USING CRON 0 6 * * 1 UTC
#   Hourly                 60 MINUTES
#   Only when you upload   MANUAL
# deploy.sh applies it. To change it without a full deploy, see "Pipeline
# schedule" in docs/OPERATIONS_GUIDE.md.
DOC_INTEL_PIPELINE_SCHEDULE="${DOC_INTEL_PIPELINE_SCHEDULE:-USING CRON 0 6 * * * UTC}"

# --- Integration ---
DOC_INTEL_EAI=DOC_INTEL_EGRESS_EAI
DOC_INTEL_NETWORK_RULE=DOC_INTEL_EGRESS_RULE

# --- App ---
DOC_INTEL_APP_NAME=DOC_INTEL_APP
DOC_INTEL_SEARCH_SVC=doc_search_svc
# Local dev only. The deployed app uses the default CORTEX_MODEL in app/lib/db.ts.
DOC_INTEL_CORTEX_MODEL=claude-sonnet-4-5
DOC_INTEL_STAGE=doc_stage
DOC_INTEL_AGENT_NAME=doc_intelligence_agent
